% ---------- Pudełka ----------
% Każde zadanie to \section{Zadanie N. krótki opis} (bez automatycznej
% numeracji, numer jak w zestawie), a pod nim pudełko z przepisaną treścią.
\setcounter{secnumdepth}{0}
\newtcolorbox{tresc}{enhanced,breakable,colback=gray!6,colframe=gray!60,
  fonttitle=\bfseries,title={Treść}}

% Wyjaśnienie intuicyjne
\newtcolorbox{intuicja}{enhanced,breakable,colback=YellowOrange!8,
  colframe=YellowOrange!80!black,fonttitle=\bfseries,
  title={Intuicja}}

% Teoria potrzebna do zadania (definicje, twierdzenia)
\newtcolorbox{teoria}[1][Teoria]{enhanced,breakable,colback=NavyBlue!5,
  colframe=NavyBlue!70!black,fonttitle=\bfseries,title={#1}}

% Przykład liczbowy do teorii
\newtcolorbox{przyklad}[1][Przykład]{enhanced,breakable,colback=TealBlue!6,
  colframe=TealBlue!70!black,fonttitle=\bfseries,title={#1}}

% Teoria opowiedziana najprościej, bez formalizmu
\newtcolorbox{poludzku}[1][Po ludzku]{enhanced,breakable,colback=Plum!6,
  colframe=Plum!70!black,fonttitle=\bfseries,title={#1}}

% Końcowa odpowiedź
\newtcolorbox{odpowiedz}{enhanced,colback=ForestGreen!8,
  colframe=ForestGreen!70!black,fonttitle=\bfseries,title={Odpowiedź}}

\newcommand{\formalnie}{\par\medskip\noindent\textbf{\textcolor{NavyBlue!70!black}{Rozwiązanie formalne.}}\par}

% Nagłówek dokumentu. W pliku zbiorczym (\def\WSZYSTKO{}) zamiast strony
% tytułowej zestawu wstawiany jest nagłówek części + wpis w spisie treści.
\newcommand{\zestaw}[2]{%
  \ifdefined\WSZYSTKO
    \clearpage\phantomsection
    \addcontentsline{toc}{part}{Zestaw #1 --- #2}%
    \begin{center}
      {\LARGE\bfseries Zestaw #1}\\[0.2em]
      {\small #2}
    \end{center}
  \else
    \begin{center}
      {\LARGE\bfseries Metody numeryczne}\\[0.3em]
      {\Large Zestaw #1 --- rozwiązania}\\[0.2em]
      {\small #2}
    \end{center}
    \ifdefined\TELEFON\else\tableofcontents\fi
  \fi
}

% Plik zbiorczy: \wlaczzestaw{prefiks}{plik.tex} wstawia cały dokument zestawu
% (docmute pomija jego preambułę), etykiety dostają prefiks zestawu,
% więc \label{lem:x} w różnych zestawach się nie gryzie.
\ifdefined\WSZYSTKO
  \RequirePackage{docmute}
  \def\mnprefix{}
  \AtBeginDocument{%
    \let\mnoldlabel\label
    \renewcommand{\label}[1]{\mnoldlabel{\mnprefix#1}}%
    \let\mnoldref\ref
    \renewcommand{\ref}[1]{\mnoldref{\mnprefix#1}}%
  }
  \newcommand{\wlaczzestaw}[2]{%
    \begingroup
    \def\mnprefix{#1:}%
    \setcounter{definicja}{0}%
    \input{#2}%
    \endgroup
  }
\fi
